# Local development only. Copy this file to backend/.env.
SERVER_PORT=8080
JWT_SECRET=feedvid-local-development-secret-change-before-deployment
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=feedvid
MYSQL_PASSWORD=feedvid_dev_password
MYSQL_ROOT_PASSWORD=feedvid_root_dev_password
MYSQL_DATABASE=feedsystem
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
RABBITMQ_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=15672
RABBITMQ_USER=feedvid
RABBITMQ_PASS=feedvid_mq_dev_password
PPROF_ENABLED=false
